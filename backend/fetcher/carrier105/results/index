function NavTo(lang)
{
//get the existing URL
	var URL = window.location.href.toLowerCase();
	var strRepl;
	
//get the language's suffix (_sp = Spanish) the user wants to change to
	if (lang.length > 0) 
		strRepl = '_' + lang + '.asp';
	else
		strRepl = '.asp';
	
//if .asp is not found, then send to language's Home page
	if (URL.indexOf('.asp') > 0)
	{
	//if on a language other than the default language, then remove the suffix (_sp)
	//using URL.slice(0, URL.indexOf('_sp.asp')) to take QueryStrings into account
		if (URL.indexOf('_sp.asp') > 0) //(  || (URL.indexOf('_gr.asp') > 0) ) 
			URL = URL.slice(0, URL.indexOf('_sp.asp')) + strRepl;
		else
			URL = URL.slice(0, URL.indexOf('.asp')) + strRepl;
	}
	else
		URL = URL + 'Home' + strRepl;

	window.navigate(URL);
}
